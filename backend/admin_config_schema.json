{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LogAnalyzer Backend Configuration",
  "type": "object",
  "properties": {
    "data_ingestion": {
      "type": "object",
      "properties": {
        "syslog_enabled": { "type": "boolean", "default": true },
        "syslog_port": { "type": "integer", "default": 514 },
        "syslog_tls_port": { "type": "integer", "default": 6514 },
        "file_tailing_paths": { "type": "array", "items": { "type": "string" }, "default": ["/var/log/syslog", "/var/log/auth.log"] },
        "webhook_enabled": { "type": "boolean", "default": true },
        "cloud_buckets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "provider": { "type": "string", "enum": ["AWS_S3", "GCS"] },
              "bucket_name": { "type": "string" },
              "region": { "type": "string" }
            }
          }
        },
        "db_connection_pool": {
          "type": "object",
          "properties": {
            "engine": { "type": "string", "enum": ["PostgreSQL", "ClickHouse", "OpenSearch"] },
            "connection_string": { "type": "string", "description": "Encrypted DSN" },
            "max_connections": { "type": "integer", "default": 100 }
          }
        }
      }
    },
    "log_parsing": {
      "type": "object",
      "properties": {
        "active_profiles": { "type": "array", "items": { "type": "string" }, "default": ["nginx_extended", "cisco_asa"] },
        "custom_regex": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "pattern": { "type": "string", "description": "Regex with named capture groups" }
            }
          }
        },
        "global_timezone": { "type": "string", "default": "UTC" }
      }
    },
    "retention_lifecycle": {
      "type": "object",
      "properties": {
        "hot_storage_days": { "type": "integer", "default": 7 },
        "warm_storage_days": { "type": "integer", "default": 30 },
        "purge_after_days": { "type": "integer", "default": 90 },
        "disk_quota_panic_threshold_percent": { "type": "integer", "default": 90 }
      }
    },
    "observability": {
      "type": "object",
      "properties": {
        "integrations": {
          "type": "object",
          "properties": {
            "slack_webhook": { "type": "string" },
            "pagerduty_key": { "type": "string" },
            "smtp": {
              "type": "object",
              "properties": {
                "host": { "type": "string" },
                "port": { "type": "integer" }
              }
            }
          }
        },
        "alert_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "condition": { "type": "string" },
              "action": { "type": "string" }
            }
          }
        },
        "deduplication_window_minutes": { "type": "integer", "default": 15 }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "rbac_roles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role_name": { "type": "string" },
              "permissions": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "auth_gateway": { "type": "string", "enum": ["LOCAL", "OIDC", "SAML", "LDAP"], "default": "LOCAL" }
      }
    }
  }
}
